<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    
    <changeSet id="1691108310-1" author="ahira">
        <createTable tableName="auth_codes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_on" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)" defaultValue="system">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="VARCHAR(255)" defaultValue="system">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="auth_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_scope" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="granted_scope" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="code_challenge" type="TEXT"/>
            <column name="code_challenge_method" type="VARCHAR(15)"/>

        </createTable>
    </changeSet>

    <changeSet id="1691108310-2" author="ahira">
        <addUniqueConstraint tableName="auth_codes"
                             columnNames="client_id, auth_code"
                             constraintName="uc_auth_codes_client_id_auth_code"/>

        <addForeignKeyConstraint baseTableName="auth_codes"
                                 baseColumnNames="user_id"
                                 constraintName="fk_auth_codes_on_user"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="auth_codes"
                                 baseColumnNames="client_id"
                                 constraintName="fk_auth_codes_on_client"
                                 referencedTableName="clients"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>